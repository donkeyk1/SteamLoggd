# Database (local dev uses the docker-compose Postgres)
DATABASE_URL=postgresql://gamebacklog:gamebacklog_dev@localhost:5432/gamebacklog

# Auth.js — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# OAuth providers (create apps in each console; callback is /api/auth/callback/<provider>)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Steam Web API — used for library sync + achievements once a user links Steam.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# OpenXBL (Xbox Live) — used for Xbox/Game Pass library sync. Free key at:
# https://xbl.io
XBOX_API_KEY=

# IGDB via Twitch — used for game metadata + time-to-beat enrichment.
# https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
