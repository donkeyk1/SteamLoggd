// Prisma schema for the GameBacklog app.
// Run `npx prisma migrate dev --name init` to create tables locally.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(cuid())
  email         String?    @unique
  emailVerified DateTime?
  username      String?    @unique
  name          String?
  image         String?    // OAuth provider avatar
  steamImage    String?    // Steam profile avatar; preferred over `image` when set
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  userGames     UserGame[]
  syncJobs      SyncJob[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Game {
  id            String     @id @default(cuid())
  igdbId        Int?       @unique
  steamAppId    Int?       @unique
  xboxTitleId   String?    @unique // Xbox Live title id (stored as string — uint32 can exceed int4)
  title         String
  coverUrl      String?
  genres        String[]   @default([])
  themes        String[]   @default([]) // IGDB themes (Horror, Comedy, Drama…) — tone, used by vibe gate
  releaseYear   Int?
  hltbMainHours Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  userGames     UserGame[]

  @@index([title])
}

enum GameSource {
  STEAM
  XBOX
  MANUAL
}

enum GameStatus {
  WISHLIST  // want it but haven't decided to play yet
  UNTRIAGED // synced/added but you haven't decided what to do with it yet
  UNPLAYED  // you've decided you want to play this
  PLAYING
  PAUSED
  BEAT
  DROPPED
}

model UserGame {
  id                    String     @id @default(cuid())
  userId                String
  gameId                String

  source                GameSource
  platform              String?    // null = derive from source (e.g. "Steam"); set for manual entries
  status                GameStatus @default(UNTRIAGED)
  priority              Int        @default(3) // 1-5
  mood                  String[]   @default([]) // ["chill","story",...]
  isMultiplayer         Boolean    @default(false)
  wantReplay            Boolean    @default(false)

  steamPlaytimeMinutes      Int?
  steamPlaytime2weeksMinutes Int?
  manualPlaytimeMinutes     Int?

  rating                Int?
  notes                 String?

  addedAt               DateTime   @default(now())
  startedAt             DateTime?
  finishedAt            DateTime?
  lastPlayedAt          DateTime?

  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                  Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, status])
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model SyncJob {
  id          String        @id @default(cuid())
  userId      String
  type        String        // e.g. "steam_library"
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
  status      SyncJobStatus @default(PENDING)
  error       String?

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}
